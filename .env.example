APP_NAME=ticketing-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ticketing
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# === Ticketing service-specific config ===

# Shared with the Admin service. HS256 only for v1.
# IMPORTANT: must be at least 32 bytes for firebase/php-jwt v7. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=admin-service
JWT_AUDIENCE=ticketing-service
JWT_LEEWAY=10

# Admin service used to enrich admin objects in API responses.
ADMIN_SERVICE_URL=http://admin-service.local
ADMIN_SERVICE_TOKEN=
ADMIN_CACHE_TTL=300
